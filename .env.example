# Copy to .env (git-ignored) for local experiments. Never commit real credentials.
# The SDK reads these only as fallbacks when values are not passed in code.

# Ethos Integration (EthosClient / EthosAuth)
ETHOS_API_KEY=

# Native Banner REST APIs (BannerClient / BannerAuth)
BANNER_BASE_URL=https://banner.example.edu
BANNER_USERNAME=
BANNER_PASSWORD=

# Optional: set to "ellucian-banner" to log request method/path/status to stderr
# (query strings are always redacted).
# DEBUG=ellucian-banner
